@using RelayMessenger.Client.Services
@implements IAsyncDisposable
@inject ISignalRService SignalRService

<div class="message-list" style="height: 200px; overflow-y: auto; background-color: rgba(0,0,0,0.7); color: white; padding: 10px; border-radius: 8px; margin-top: 10px;">
    <h4>Mesh Messages</h4>
    @if (messages == null || !messages.Any())
    {
        <p>No messages received yet...</p>
    }
    else
    {
        @foreach (var msg in messages.AsEnumerable().Reverse())
        {
            <div class="message-item" style="border-bottom: 1px solid #444; padding: 5px 0;">
                @msg
            </div>
        }
    }
</div>

@code {
    private List<string> messages = new();

    protected override void OnInitialized()
    {
        SignalRService.OnMessageReceived += HandleMessage;
    }

    private void HandleMessage(string message)
    {
        messages.Add($"{DateTime.Now:HH:mm:ss} - {message}");
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SignalRService.OnMessageReceived -= HandleMessage;
    }
}