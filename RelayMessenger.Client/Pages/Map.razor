@page "/map"
@using RelayMessenger.Client.Interops
@inject NodeService NodeService
@inject GoogleMapsInterop GoogleMaps
@inject IJSRuntime JS


@implements IAsyncDisposable

<PageTitle>Map</PageTitle>

<h1 style="padding: 20px;">Mesh Map</h1>

<div style="padding: 20px;">
    @if (nodes == null)
    {
        <p>Loading nodes...</p>
    }
    else if (nodes.Count == 0)
    {
        <p>No nodes found.</p>
    }
    else
    {
        <div id="map" style="height:70vh; width:100%; border:1px solid black;"></div>

        <MessageList />

        <div style="margin-top: 20px; padding: 20px; border: 1px solid #ccc; border-radius: 8px; background: #f9f9f9;">
            <h3>Send Message</h3>
            <div style="display: flex; flex-direction: column; gap: 10px; max-width: 400px;">
                <label>
                    Target Node:
                    <select @bind="selectedNodeId" style="width: 100%; padding: 5px;">
                        <option value="0">Broadcast</option>
                        @foreach (var node in nodes)
                        {
                            if (node.Id != 0)
                            {
                                <option value="@node.Id">@node.Name</option>
                            }
                        }
                    </select>
                </label>
                <textarea @bind="messageText" placeholder="Enter your message..." style="width: 100%; height: 100px; padding: 5px;"></textarea>
                <button @onclick="SendMessage" style="padding: 10px; cursor: pointer;">Send</button>
            </div>
        </div>
    }
</div>

@code {
    private List<NodeStateModel>? nodes;
    private uint? selectedNodeId = 0;
    private string messageText = string.Empty;
    private IJSObjectReference? _mapModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NodeService.InitializeAsync();
            nodes = await NodeService.GetInitialNodesAsync();

            if (nodes != null && nodes.Count > 0)
            {
                _mapModule = await JS.InvokeAsync<IJSObjectReference>("globalThis.relayMessenger.googleMaps.CreateMapModule");
                await GoogleMaps.Initialize(_mapModule);
                await _mapModule.InvokeVoidAsync("addListenerOnceMapIdle", DotNetObjectReference.Create(this));
                await GoogleMaps.SyncMarkers(nodes);
            }

            NodeService.OnNodesUpdated += UpdateMap;
            StateHasChanged();
        }
    }

    private async Task UpdateMapAsync()
    {
        if (nodes != null)
        {
            await GoogleMaps.SyncMarkers(nodes);
        }
        StateHasChanged();
    }

    private void UpdateMap()
    {
        _ = UpdateMapAsync();
    }

    private async Task SendMessage()
    {
        if (nodes != null && !string.IsNullOrWhiteSpace(messageText))
        {
            await NodeService.SendClientMessage(selectedNodeId, messageText);
            messageText = string.Empty;
            Console.WriteLine($"Sent message to {selectedNodeId}");
        }
    }

    [JSInvokable]
    public void OnMapIdle()
    {
        StateHasChanged();
    }

    [JSInvokable]
    public void UpdateCurrentPosition(double lat, double lng)
    {
        Console.WriteLine($"UpdateCurrentPosition: {lat}, {lng}");
    }

    [JSInvokable]
    public void UpdateMyInfoMarker(string message, double lat, double lng)
    {
        Console.WriteLine($"UpdateMyInfoMarker: {message} at {lat}, {lng}");
    }

    public async ValueTask DisposeAsync()
    {
        NodeService.OnNodesUpdated -= UpdateMap;
        if (_mapModule != null)
        {
            await _mapModule.DisposeAsync();
        }
    }
}