{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch and Debug Standalone Blazor WebAssembly App",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/RelayMessenger.Client",
            "url": "https://localhost:7268",
            "browser": "edge"
        },
        {
            "name": "Launch Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-server",
            "program": "${workspaceFolder}/RelayMessenger.Server/bin/Debug/net10.0/RelayMessenger.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/RelayMessenger.Server",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Run Unit Tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests",
            "program": "${workspaceFolder}/RelayMessenger.Server.UnitTests/bin/Debug/net10.0/RelayMessenger.Server.UnitTests.dll",
            "args": [
                "--filter",
                "FullyQualifiedName~MeshtasticPacketProcessorTests"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Run Integration Tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-server",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/RelayMessenger.Server.IntegrationTests/RelayMessenger.Server.IntegrationTests.csproj",
                "--nologo",
                "-v",
                "normal"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}
    ]
}